<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.blog.auth.dao.RoleMapper">

    <resultMap id="BaseResultMap" type="com.blog.core.domain.auth.entity.Role">
        <id property="id" column="id" />
        <result property="roleCode" column="role_code"/>
        <result property="roleName" column="role_name"/>
        <result property="createBy" column="create_by"/>
        <result property="createTime" column="create_time"/>
        <result property="updateBy" column="update_by"/>
        <result property="updateTime" column="update_time"/>
    </resultMap>

    <sql id="BaseResultSql">
        id, role_code, role_name, create_by, create_time, update_by, update_time
    </sql>

    <!--查看用户对应的角色-->
    <select id="selectUserRole" resultType="com.blog.core.domain.auth.entity.Role">
        SELECT <include refid="BaseResultSql"></include>
        from sys_role
        WHERE id in (SELECT role_id from sys_user_role WHERE user_id = #{userId})
    </select>


    <!--删除角色关联的用户-->
    <delete id="deleteRoleUser">
        DELETE
        from sys_user_role
        WHERE role_id = #{roleId}
    </delete>

    <!--删除角色关联的菜单-->
    <delete id="deleteRoleMenu">
        DELETE
        from sys_menu_role
        WHERE role_id = #{roleId}
    </delete>


</mapper>