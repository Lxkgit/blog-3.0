<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.blog.file.mapper.FileCategoryDataMapper">
    <resultMap id="BaseResultMap" type="com.blog.core.domain.file.files.entity.FileCategoryData">
        <id column="id" property="id"/>
        <result column="user_id" property="userId"/>
        <result column="file_name" property="fileName"/>
        <result column="file_category_id" property="fileCategoryId"/>
        <result column="file_url" property="fileUrl"/>
        <result column="file_size" property="fileSize"/>
        <result column="file_status" property="fileStatus"/>
        <result column="file_type" property="fileType"/>
        <result column="file_json" property="fileJson"/>
        <result column="file_code" property="fileCode"/>
        <result column="create_by" property="createBy"/>
        <result column="create_time" property="createTime"/>
    </resultMap>

    <sql id="Base_Column_List">
        id, user_id, file_name, file_category_id, file_url, file_size, file_status, file_type, file_json, file_code, create_by, create_time
    </sql>


    <update id="updateFileCodeByIdAndUserId" parameterType="com.blog.core.domain.file.files.entity.FileCategoryData">
        update file_category_data
        set file_code = #{fileCode}
        where id = #{id}
    </update>

</mapper>