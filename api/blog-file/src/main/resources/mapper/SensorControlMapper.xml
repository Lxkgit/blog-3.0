<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.blog.file.mapper.SensorControlMapper">
    <resultMap id="BaseResultMap" type="com.blog.core.domain.file.device.entity.SensorControl">
        <id column="id" property="id" jdbcType="INTEGER"/>
        <result column="user_id" property="userId" jdbcType="INTEGER"/>
        <result column="chip_id" property="chipId" jdbcType="INTEGER"/>
        <result column="sensor_id" property="sensorId" jdbcType="INTEGER"/>
        <result column="control_name" property="controlName" jdbcType="VARCHAR"/>
        <result column="control_message" property="controlMessage" jdbcType="VARCHAR"/>
        <result column="command_group" property="commandGroup" jdbcType="INTEGER"/>
        <result column="sensor_id_group" property="sensorIdGroup" jdbcType="VARCHAR"/>
        <result column="create_time" property="createTime" jdbcType="TIMESTAMP"/>
        <result column="update_time" property="updateTime" jdbcType="TIMESTAMP"/>
    </resultMap>


    <sql id="Base_Column_List">
        id, user_id, sensor_id, control_name, control_message, create_time, update_time
    </sql>

    <update id="updateSensorControlById" parameterType="com.blog.core.domain.file.device.entity.SensorControl">
        update blog_sensor_control
        set control_name = #{controlName}, control_message = #{controlMessage}, update_time = #{updateTime}
        where id = #{id} and user_id = #{userId}
    </update>

</mapper>