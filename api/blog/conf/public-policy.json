{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Principal": {
        "AWS": ["*"]
      },
      "Action": ["s3:GetObject"],
      "Resource": [
        "arn:aws:s3:::blog/*/article/*",
        "arn:aws:s3:::blog/*/doc/*",
        "arn:aws:s3:::blog/*/system/*"
      ]
    },
    {
      "Effect": "Deny",
      "Principal": {
        "AWS": ["*"]
      },
      "Action": ["s3:GetObject"],
      "Resource": [
        "arn:aws:s3:::blog/*/diary/*",
        "arn:aws:s3:::blog/*/device/*",
        "arn:aws:s3:::blog/*/other/*",
        "arn:aws:s3:::blog/*/user/*"
      ]
    }
  ]
}