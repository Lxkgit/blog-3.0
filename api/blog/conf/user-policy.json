{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Principal": {
        "AWS": ["*"]
      },
      "Action": ["s3:*"],
      "Resource": [
        "arn:aws:s3:::blog",
        "arn:aws:s3:::blog/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:username": "minio"
        }
      }
    }
  ]
}