[Unit]
Description=Automount NTFS Drive %I
After=network.target local-fs.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/bash -c '\
  UUID_PATH="/dev/disk/by-uuid/%I"; \
  MOUNTPOINT="/mnt/%I"; \
  if [ -b "$UUID_PATH" ]; then \
    mkdir -p "$MOUNTPOINT"; \
    mount -t ntfs-3g -o uid=1000,gid=1000,umask=000 "$UUID_PATH" "$MOUNTPOINT"; \
    echo "Mounted $UUID_PATH on $MOUNTPOINT"; \
  else \
    echo "Device $UUID_PATH not found"; \
  fi'

ExecStop=/usr/bin/bash -c '\
  UUID_PATH="/dev/disk/by-uuid/%I"; \
  MOUNTPOINT="/mnt/%I"; \
  if mountpoint -q "$MOUNTPOINT"; then \
    umount "$MOUNTPOINT"; \
    echo "Unmounted $UUID_PATH"; \
  fi'

[Install]
WantedBy=multi-user.target
